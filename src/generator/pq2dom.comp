#version 450

// import conversion: per-channel PQ (ST 2084) code -> generator domain.
//
// the day curve for the 16F pipeline, back after the 8-bit route failed:
// feeding converted codes through generate_8bit corrupted colour on this
// game, so the day mode stays on the proven 16F pipeline. the exponent is
// the measured balance: menu backgrounds keep signal, shadow noise only
// mildly audible; 2.4 traded menus away and lost on net.
//
// EOTF: Y/10000 = ((max(P^(1/m2) - c1, 0)) / (c2 - c3 * P^(1/m2)))^(1/m1)
// domain: D = Y^(1/2.6)

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform image2D img;

const float m1 = 0.1593017578125; // 1305 / 8192
const float m2 = 78.84375;         // 2523 / 4096 * 128
const float c1 = 0.8359375;       // 3424 / 4096
const float c2 = 18.8515625;      // 2413 / 4096 * 32
const float c3 = 18.6875;         // 2392 / 4096 * 32

// the only knob: domain exponent (1.0 = linear, 2.2 = sRGB-ish, 2.6 = the
// measured day balance)
const float G = 2.6;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    if (uv.x >= imageSize(img).x || uv.y >= imageSize(img).y) return;
    vec4 p = pow(imageLoad(img, uv), vec4(1.0 / m2));
    vec4 lin = pow(max(p - vec4(c1), vec4(0.0)) / (vec4(c2) - c3 * p), vec4(1.0 / m1));
    imageStore(img, uv, pow(lin, vec4(1.0 / G)));
}
